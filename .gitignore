# ============================================================
# MSU1Converter / RetroMusic Lab —— 只把「源码 + 文档 + 门禁」入库
# 成品 exe / zip / 构建树 / 运行日志 / BIOS 一律不入库
# ============================================================

# ---- 构建与运行产物 ----
__pycache__/
*.py[cod]
*.pyo
*.o
*.obj
*.pdb
*.ilk
*.exp
msu1-to-cd/build/
msu1-to-cd/dist/
msu1-to-cd/output/
msu1-to-cd/logs/
msu1-to-cd/tmp/
msu1-to-cd/_pyi_unpack_tmp/
**/_MEI*/
tools/*/obj/
tools/*/build/

# ---- 交付物（成品 68MB exe + 产品 zip，可重建）----
deliverables/
*.zip
*.7z
*.rar

# ---- 版权受限素材：PS1 BIOS 不进仓库 ----
msu1-to-cd/bios/
**/scph*.bin

# ---- 本机配置 / 记忆 / 临时 ----
.workbuddy/
*.tmp
*.bak
*.log
# 单实例运行锁（<pid> <次> <时间戳>），冒烟/实跑都会生成
msu1-to-cd/.running
# PSF 播放用的 BIOS 路径（一行本机绝对路径）。程序自己会写，换台机器就失效，
# 入库只会让每次提交都多一个「要记得还原」的噪声。
# 查找优先级见 psf_native.find_bios()：环境变量 MSU1_PSF_BIOS > 本文件 >
# 程序目录 bios/ > 常见模拟器目录。文件不在也能正常跑。
msu1-to-cd/psf_bios.txt

# ---- 原型截图输出（docs/deck/tools/shot_aura.py 生成）----
docs/deck/shots/

# ---- 本机 AI 记忆（含个人路径，不入公开库）----
.workbuddy-ai/
